**/chroma_db/
**/pdf_chroma_db/

# Local memory databases
memory-chat/*.db
memory-chat/*.sqlite
memory-chat/*.sqlite3

# SQLite temporary files
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm


